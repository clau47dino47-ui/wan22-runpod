# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3-pip git curl ffmpeg \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip

RUN pip install "numpy<2"

RUN pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124

# VideoX-Fun (Wan2.1-Fun-Control pipeline) — clone and copy package directly
RUN git clone --depth 1 https://github.com/aigc-apps/VideoX-Fun.git /videox_fun_repo \
    && cp -r /videox_fun_repo/videox_fun /usr/local/lib/python3.10/dist-packages/videox_fun \
    && printf 'from .pipeline_wan_fun_control import WanFunControlPipeline\n__all__ = ["WanFunControlPipeline"]\n' \
       > /usr/local/lib/python3.10/dist-packages/videox_fun/pipeline/__init__.py \
    && printf 'from transformers import AutoTokenizer\nfrom .wan_vae import AutoencoderKLWan\nfrom .wan_image_encoder import CLIPModel\nfrom .wan_text_encoder import WanT5EncoderModel\nfrom .wan_transformer3d import WanTransformer3DModel\n__all__ = ["AutoTokenizer", "AutoencoderKLWan", "CLIPModel", "WanT5EncoderModel", "WanTransformer3DModel"]\n' \
       > /usr/local/lib/python3.10/dist-packages/videox_fun/models/__init__.py

# DWPose via rtmlib (ONNX-based, no mmcv/mmpose/mmdet required) + GPU backend
# rtmlib pulls onnxruntime (CPU) as dependency — must replace with GPU version pinned to 1.20.1
# (1.21+ lacks CUDAExecutionProvider on this CUDA 12.4 build)
RUN pip install rtmlib \
    && pip uninstall -y onnxruntime || true \
    && pip install "onnxruntime-gpu==1.20.1"

RUN pip install \
    "diffusers>=0.32.2" \
    "transformers>=4.50.0" \
    "accelerate>=1.4.0" \
    sentencepiece \
    ftfy \
    einops \
    omegaconf \
    safetensors \
    scipy \
    "imageio[ffmpeg]" \
    opencv-python-headless \
    boto3 \
    psycopg2-binary \
    fastapi \
    "uvicorn[standard]" \
    pydantic \
    requests \
    pillow

# SageAttention for speedup
RUN pip install sageattention

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/workspace/cache/huggingface \
    HF_HUB_CACHE=/workspace/cache/huggingface/hub \
    PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.10 /usr/local/lib/python3.10
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app
COPY server_funcontrol.py .
COPY wan_civitai.yaml .

EXPOSE 3452
CMD ["python3.10", "-m", "uvicorn", "server_funcontrol:app", "--host", "0.0.0.0", "--port", "3452"]
